{
  "name": "proxy-moxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session-scoped HTTP proxy with a live request inspector.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --filter @proxy-moxy/backend start",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
